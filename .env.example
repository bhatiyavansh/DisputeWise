# Copy to .env and adjust as needed. Used by docker-compose and the backend app.

POSTGRES_USER=disputewise
POSTGRES_PASSWORD=disputewise
POSTGRES_DB=disputewise
POSTGRES_HOST=db
POSTGRES_PORT=5432

API_DEFAULT_PAGE_SIZE=25
API_MAX_PAGE_SIZE=200

# Dataset generation
DATASET_SEED=42
DATASET_N_CASES=50000

# Phase 4 -- all optional. Leave everything below unset to run fully without
# an LLM: evidence-gap analysis, evidence packets, and RAG retrieval all work
# with no key configured. Without a usable provider, POST /cases/{id}/draft
# returns response_state=GENERATION_UNAVAILABLE (still includes
# decision/evidence-gap/retrieved-sources) instead of a generated draft.
# Never commit a real key -- this file is an example only; copy to .env and
# fill in OPENROUTER_API_KEY there (which is gitignored).

# Provider selection: "openrouter" (default, used for the buildathon demo) or
# "anthropic" (kept for architecture provider-agnosticism; not used for the demo).
LLM_PROVIDER=openrouter

# Must be a genuinely free (":free"-suffixed) OpenRouter model that supports
# forced tool-choice -- OpenRouterLLMProvider refuses to start otherwise (see
# docs/phase4.md "OpenRouter setup" for how this specific model was verified
# against OpenRouter's live /api/v1/models endpoint). Do not change this to a
# paid model without also reviewing app/evidence_intel/llm_provider.py's
# free-tier safety check.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Get a free key at https://openrouter.ai/settings/keys -- leave blank/unset
# to run without generation (see above).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Only used if LLM_PROVIDER=anthropic. Not used for the demo.
# ANTHROPIC_API_KEY=
