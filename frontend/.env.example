# Copy to .env.local for local overrides (gitignored).
#
# By default VITE_API_BASE_URL is unset, meaning the frontend calls its OWN
# origin (e.g. http://localhost:5173) and relies on the Vite dev/preview
# server's proxy (see vite.config.ts) to forward /cases and /health through
# to the real backend at http://localhost:8001. This exists because the
# backend does not send CORS headers, and the frontend is not allowed to
# modify the backend to add them -- see docs/frontend.md.
#
# Only set this if you want to bypass the proxy and call a backend directly
# (e.g. one that already sends its own CORS headers).
# VITE_API_BASE_URL=http://localhost:8001

# DEV ONLY. When "true", the frontend falls back to a local placeholder for
# POST /cases/{id}/decision if the real endpoint is unreachable/unavailable.
# Has NO effect in a production build regardless of this value. Leave unset
# (or "false") to always require the real backend -- the real /decision
# endpoint is already implemented, so this should normally stay off.
VITE_ENABLE_DECISION_MOCK=false
